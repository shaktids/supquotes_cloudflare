{
  "name": "supquotes",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "content:watch": "node scripts/build-content.mjs --watch",
    "dev": "astro dev",
    "build": "node scripts/build-content.mjs && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "edge:dev": "node scripts/build-content.mjs && wrangler dev -c workers/edge/wrangler.jsonc",
    "edge:deploy": "node scripts/build-content.mjs && wrangler deploy -c workers/edge/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "astro": "^7.4.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "workers-og": "^0.0.27",
    "wrangler": "^4.168.0"
  }
}
