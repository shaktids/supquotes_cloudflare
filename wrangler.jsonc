{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supquotes",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The adapter writes dist/server/wrangler.json (assets → dist/client) and `wrangler deploy` uses it.
  "assets": { "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Custom domains: Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "supquotes.com", "custom_domain": true },
    { "pattern": "www.supquotes.com", "custom_domain": true }
  ],
  "vars": {
    // Public base URL of the Internxt media gateway (rclone serve s3 behind a Cloudflare Tunnel).
    // Only needed if templates/festivals use background art. Path-style S3: https://<host>/<bucket>
    "MEDIA_BASE_URL": "https://media.supquotes.com/supquotes",
    // The edge Worker that draws OG images.
    "OG_BASE_URL": "https://og.supquotes.com",
    // Timezone for "today" (daily pick, festival switch).
    "SITE_TZ": "Asia/Kolkata"
  }
  // No secrets and no database: content is bundled at build time from content/.
}
