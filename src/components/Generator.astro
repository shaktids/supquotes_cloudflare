---
import type { Quote, Wish, Template, Topic, Occasion } from "../lib/db";

interface Props {
  mode: "quote" | "wish";
  quote: Quote | null;
  wish: Wish | null;
  name?: string;
  templates: (Template & { bg_url: string | null })[];
  topics: (Topic & { is_occasion: boolean })[];
  occasions: Occasion[];
  templateId?: number | null;
  festivalOccasion?: string | null;
}
const p = Astro.props;
const data = {
  mode: p.mode,
  quote: p.quote,
  wish: p.wish,
  name: p.name ?? "",
  templates: p.templates,
  templateId: p.templateId ?? null,
  festivalOccasion: p.festivalOccasion ?? null,
  occasion: p.wish?.occasion ?? p.festivalOccasion ?? "birthday",
};
// On a festival day the Quote tab starts on that day's topic, if there are quotes for it.
const defaultTopic = p.festivalOccasion && p.topics.some((t) => t.slug === p.festivalOccasion) ? p.festivalOccasion : "";
const everydayTopics = p.topics.filter((t) => !t.is_occasion);
const dayTopics = p.topics.filter((t) => t.is_occasion);
const everydayOcc = p.occasions.filter((o) => o.everyday);
const festOcc = p.occasions.filter((o) => !o.everyday);
---
<section class="gen" id="gen">
  <div class="gen-preview card">
    <canvas id="gen-canvas" width="1080" height="1080" aria-label="Card preview" role="img"></canvas>
    <div class="formats" role="group" aria-label="Card size">
      <button type="button" class="chip" data-format="square" aria-pressed="true">Post 1:1</button>
      <button type="button" class="chip" data-format="story" aria-pressed="false">Status 9:16</button>
    </div>
  </div>

  <div class="gen-panel">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" data-mode="quote" aria-selected={p.mode === "quote"}>Quote</button>
      <button type="button" role="tab" data-mode="wish" aria-selected={p.mode === "wish"}>Wish</button>
    </div>

    <div class="field" data-for="quote">
      <label for="gen-topic">Topic</label>
      <select id="gen-topic">
        <option value="">Any topic</option>
        <optgroup label="Topics">
          {everydayTopics.map((t) => <option value={t.slug} selected={t.slug === defaultTopic}>{t.emoji} {t.name}</option>)}
        </optgroup>
        {dayTopics.length > 0 && (
          <optgroup label="Festivals & days">
            {dayTopics.map((t) => <option value={t.slug} selected={t.slug === defaultTopic}>{t.emoji} {t.name}</option>)}
          </optgroup>
        )}
      </select>
    </div>

    <div class="row" data-for="wish">
      <div class="field">
        <label for="gen-occasion">Occasion</label>
        <select id="gen-occasion">
          <optgroup label="Everyday">
            {everydayOcc.map((o) => <option value={o.key} selected={o.key === data.occasion}>{o.label}</option>)}
          </optgroup>
          <optgroup label="Festivals & days (next first)">
            {festOcc.map((o) => (
              <option value={o.key} selected={o.key === data.occasion}>
                {o.label}{o.on_now ? " · today" : o.next_on ? ` · ${new Date(`${o.next_on}T00:00:00`).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}` : ""}
              </option>
            ))}
          </optgroup>
        </select>
      </div>
      <div class="field">
        <label for="gen-name">Their name</label>
        <input id="gen-name" type="text" maxlength="40" placeholder="e.g. Priya" value={data.name} autocomplete="off" />
      </div>
    </div>

    <div class="field">
      <label for="gen-text">Text <span class="hint">(you can edit it)</span></label>
      <textarea id="gen-text" rows="4"></textarea>
    </div>

    <button type="button" class="btn btn-primary next" id="gen-next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5"/></svg>
      <span>New quote</span>
    </button>

    <div class="field">
      <span class="label">Style</span>
      <div class="swatches" id="gen-templates" role="radiogroup" aria-label="Card style"></div>
    </div>

    <div class="share">
      <button type="button" class="btn btn-primary btn-share" id="share-main">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
        Share
      </button>
      <button type="button" class="btn btn-wa btn-icon" id="share-wa" aria-label="Send on WhatsApp" title="Send on WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2c.2-.5.2-1 .1-1.1l-.5-.3z"/></svg>
      </button>
      <div class="more">
        <button type="button" class="btn btn-icon" id="share-more" aria-label="More share options" aria-haspopup="true" aria-expanded="false" aria-controls="share-menu">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
        </button>
        <div class="menu card" id="share-menu" role="menu" hidden>
          <button type="button" role="menuitem" data-act="download">Download image</button>
          <button type="button" role="menuitem" data-act="link">Copy link</button>
          <button type="button" role="menuitem" data-act="text">Copy text</button>
          <button type="button" role="menuitem" data-act="whatsapp">Send on WhatsApp</button>
        </div>
      </div>
    </div>
    <p class="tip">For WhatsApp Status or Instagram Story, pick <b>Status 9:16</b> first.</p>
    <p class="toast" id="gen-toast" role="status" aria-live="polite"></p>
  </div>
</section>

<script type="application/json" id="gen-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<script>
  import { drawCard, canvasToFile } from "../lib/render";
  import { parseLayout, fillName, type FormatKey } from "../../shared/layout";

  type Tpl = { id: number; name: string; kind: string; occasion: string | null; layout_json: string; bg_url: string | null };
  const S = JSON.parse(document.getElementById("gen-data")!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const canvas = $<HTMLCanvasElement>("gen-canvas");
  const textEl = $<HTMLTextAreaElement>("gen-text");
  const nameEl = $<HTMLInputElement>("gen-name");
  const topicEl = $<HTMLSelectElement>("gen-topic");
  const occEl = $<HTMLSelectElement>("gen-occasion");
  const toastEl = $("gen-toast");
  let format: FormatKey = "square";
  let custom: string | null = null;

  const toast = (msg: string) => {
    toastEl.textContent = msg;
    clearTimeout((toast as any).t);
    (toast as any).t = setTimeout(() => (toastEl.textContent = ""), 4000);
  };

  const baseText = () => (S.mode === "quote" ? S.quote?.text ?? "" : S.wish?.text ?? "");
  const cardText = () => (S.mode === "quote" ? custom ?? baseText() : fillName(custom ?? baseText(), nameEl.value));
  const cardAuthor = () => (S.mode === "quote" && custom == null ? S.quote?.author ?? null : null);

  function usableTemplates(): Tpl[] {
    const occ = S.mode === "wish" ? occEl.value : null;
    const list = (S.templates as Tpl[]).filter(
      (t) => (t.kind === "any" || t.kind === S.mode) && (t.occasion == null || t.occasion === occ),
    );
    return list.sort((a, b) => Number(b.occasion === occ) - Number(a.occasion === occ));
  }
  const currentTemplate = (): Tpl | undefined => {
    const list = usableTemplates();
    return list.find((t) => t.id === S.templateId) ?? list[0];
  };

  function renderSwatches() {
    const box = $("gen-templates");
    const cur = currentTemplate();
    box.innerHTML = "";
    for (const t of usableTemplates()) {
      const l = parseLayout(t.layout_json);
      const b = document.createElement("button");
      b.type = "button";
      b.className = "swatch";
      b.setAttribute("role", "radio");
      b.setAttribute("aria-checked", String(t.id === cur?.id));
      b.title = t.name;
      b.innerHTML = `<span class="sr-only">${t.name}</span>`;
      b.style.background = t.bg_url
        ? `center/cover url("${t.bg_url}")`
        : l.bg.type === "solid" ? l.bg.color : `linear-gradient(${l.bg.angle ?? 135}deg, ${l.bg.colors.join(",")})`;
      b.onclick = () => { S.templateId = t.id; renderSwatches(); draw(); };
      box.appendChild(b);
    }
  }

  async function paint(target: HTMLCanvasElement, fmt: FormatKey) {
    const t = currentTemplate();
    const layout = parseLayout(t?.layout_json);
    if (S.mode === "wish") layout.quoteMark = null; // the big quote mark only suits quotes
    await drawCard(target, { layout, bgUrl: t?.bg_url, text: cardText(), author: cardAuthor(), format: fmt });
  }
  let drawing = 0;
  async function draw() {
    const id = ++drawing;
    await paint(canvas, format);
    if (id !== drawing) return;
    canvas.parentElement!.dataset.format = format;
  }

  function syncUi() {
    document.querySelectorAll<HTMLElement>("[data-for]").forEach((el) => (el.hidden = el.dataset.for !== S.mode));
    document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.mode === S.mode)));
    $("gen-next").querySelector("span")!.textContent = S.mode === "quote" ? "New quote" : "New wish";
    textEl.value = custom ?? (S.mode === "quote" ? baseText() : baseText());
    renderSwatches();
    draw();
  }

  async function next() {
    const btn = $<HTMLButtonElement>("gen-next");
    btn.disabled = true;
    try {
      const q = new URLSearchParams();
      if (S.mode === "quote") {
        if (topicEl.value) q.set("topic", topicEl.value);
        if (S.quote) q.set("exclude", S.quote.id);
        const r = await fetch(`/api/quote/random?${q}`);
        if (r.ok) S.quote = await r.json(); else toast("No quotes for that topic yet.");
      } else {
        q.set("occasion", occEl.value);
        if (S.wish) q.set("exclude", S.wish.id);
        const r = await fetch(`/api/wish/random?${q}`);
        if (r.ok) S.wish = await r.json(); else toast("No wishes for that occasion yet.");
      }
      custom = null;
      syncUi();
    } finally {
      btn.disabled = false;
    }
  }

  // ----- sharing -----
  function shareUrl() {
    const u = new URL(location.origin);
    const t = currentTemplate()?.id;
    if (S.mode === "quote" && S.quote) u.pathname = `/q/${S.quote.id}`;
    else if (S.mode === "wish" && S.wish) {
      u.pathname = `/wish/${S.wish.id}`;
      if (nameEl.value.trim()) u.searchParams.set("name", nameEl.value.trim());
    }
    if (t) u.searchParams.set("t", String(t));
    return u.toString();
  }
  const shareText = () => (cardAuthor() ? `“${cardText()}” — ${cardAuthor()}` : cardText());

  async function imageFile(fmt: FormatKey) {
    const off = document.createElement("canvas");
    await paint(off, fmt);
    return canvasToFile(off, `supquotes-${fmt}.png`);
  }
  function download(file: File) {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(file);
    a.download = file.name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  }
  const whatsapp = () =>
    window.open(`https://wa.me/?text=${encodeURIComponent(`${shareText()}\n${shareUrl()}`)}`, "_blank", "noopener");
  async function copy(value: string, msg: string) {
    try { await navigator.clipboard.writeText(value); toast(msg); }
    catch { toast("Couldn't copy. Select the text and copy it manually."); }
  }

  // ----- share menu (desktop fallback + always-available extras) -----
  const menu = $("share-menu");
  const moreBtn = $("share-more");
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    moreBtn.setAttribute("aria-expanded", String(open));
    if (open) menu.querySelector<HTMLButtonElement>("button")?.focus();
  };
  moreBtn.onclick = (e) => { e.stopPropagation(); setMenu(menu.hidden); };
  document.addEventListener("click", (e) => { if (!menu.hidden && !menu.contains(e.target as Node)) setMenu(false); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu.hidden) { setMenu(false); moreBtn.focus(); } });
  menu.addEventListener("click", async (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>("[data-act]")?.dataset.act;
    if (!act) return;
    setMenu(false);
    if (act === "download") {
      try { download(await imageFile(format)); } catch { toast("Couldn't export this style. Try another one."); }
    } else if (act === "link") copy(shareUrl(), "Link copied.");
    else if (act === "text") copy(shareText(), "Text copied.");
    else if (act === "whatsapp") whatsapp();
  });

  // ----- the one Share button -----
  // Phones: the system share sheet with the card image (WhatsApp Status/chat, Instagram Story, Telegram, …).
  // Desktop / no file sharing: open the menu instead.
  $("share-main").onclick = async (e) => {
    e.stopPropagation();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    try {
      let file: File;
      try {
        file = await imageFile(format);
      } catch {
        toast("Couldn't export this style. Try another one.");
        return;
      }
      if (!navigator.canShare?.({ files: [file] })) {
        setMenu(true);
        return;
      }
      const text = `${shareText()}\n${shareUrl()}`;
      try {
        // WhatsApp uses the text as the caption; Instagram ignores it.
        await navigator.share(navigator.canShare({ files: [file], text }) ? { files: [file], text } : { files: [file] });
      } catch (err) {
        const name = (err as DOMException).name;
        if (name === "AbortError") return; // user closed the sheet
        try { await navigator.share({ files: [file] }); } // some targets reject file + text
        catch (err2) { if ((err2 as DOMException).name !== "AbortError") setMenu(true); }
      }
    } finally {
      btn.disabled = false;
    }
  };
  $("share-wa").onclick = whatsapp;

  // ----- events -----
  document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) =>
    b.addEventListener("click", async () => {
      if (S.mode === b.dataset.mode) return;
      S.mode = b.dataset.mode;
      custom = null;
      const u = new URL(location.href);
      u.searchParams.set("mode", S.mode);
      history.replaceState(null, "", u);
      if ((S.mode === "quote" && !S.quote) || (S.mode === "wish" && !S.wish)) await next();
      else syncUi();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>("[data-format]").forEach((b) =>
    b.addEventListener("click", () => {
      format = b.dataset.format as FormatKey;
      document.querySelectorAll("[data-format]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      draw();
    }),
  );
  $("gen-next").onclick = next;
  topicEl.onchange = next;
  occEl.onchange = () => { S.templateId = null; next(); };
  nameEl.oninput = () => draw();
  textEl.oninput = () => {
    const v = textEl.value;
    custom = v === baseText() ? null : v;
    draw();
  };

  if (S.mode === "wish" && !S.wish) next();
  else syncUi();
  document.fonts?.ready.then(() => draw());
</script>

<style>
  .gen { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; margin-top: 20px; align-items: start; }
  .gen-preview { padding: 14px; position: sticky; top: 12px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .gen-preview canvas { width: 100%; height: auto; border-radius: 10px; display: block; background: var(--surface-2); }
  .gen-preview[data-format="story"] canvas { width: auto; max-height: 72vh; max-width: 100%; }
  .formats { display: flex; gap: 8px; }
  .gen-panel { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .tabs { display: inline-flex; background: var(--surface-2); padding: 4px; border-radius: 999px; align-self: start; }
  .tabs button { border: 0; background: none; font: 600 15px/1 "Poppins", sans-serif; padding: 10px 22px; border-radius: 999px; cursor: pointer; color: var(--muted); }
  .tabs button[aria-selected="true"] { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  [hidden] { display: none !important; }
  .hint { font-weight: 400; }
  .label { font-size: 13px; color: var(--muted); font-weight: 500; display: block; margin-bottom: 6px; }
  textarea { resize: vertical; min-height: 96px; }
  .next { align-self: start; }
  .swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  .swatches :global(.swatch) { width: 44px; height: 44px; border-radius: 12px; border: 2px solid var(--line); cursor: pointer; padding: 0; }
  .swatches :global(.swatch[aria-checked="true"]) { border-color: var(--text); box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--text); }
  .share { display: flex; gap: 8px; border-top: 1px solid var(--line); padding-top: 16px; }
  .btn-share { flex: 1; height: 48px; font-size: 16px; }
  .btn-icon { width: 48px; height: 48px; padding: 0; flex: none; }
  .btn-icon svg { width: 22px; height: 22px; }
  .more { position: relative; }
  .menu { position: absolute; right: 0; bottom: calc(100% + 8px); min-width: 200px; padding: 6px; z-index: 10; display: flex; flex-direction: column; }
  .menu[hidden] { display: none; }
  .menu button { text-align: left; background: none; border: 0; padding: 10px 12px; border-radius: 8px; font: 500 14px/1.2 "Poppins", sans-serif; color: var(--text); cursor: pointer; }
  .menu button:hover, .menu button:focus-visible { background: var(--surface-2); outline: none; }
  .tip { margin: -6px 0 0; font-size: 13px; color: var(--muted); }
  .toast { min-height: 1.4em; margin: 0; font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) {
    .gen { grid-template-columns: 1fr; gap: 16px; }
    .gen-preview { position: static; }
    .row { grid-template-columns: 1fr; }
  }
</style>
