{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "supquotes-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Draws link-preview images. Content is bundled from generated/content.json: run
  // `npm run content` (edge:dev / edge:deploy do it for you) after changing content/.
  "routes": [{ "pattern": "og.supquotes.com", "custom_domain": true }],
  "vars": {
    "MEDIA_BASE_URL": "https://media.supquotes.com/supquotes"
  },
  "dev": { "port": 8788 }
}
